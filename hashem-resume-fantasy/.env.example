# Server-only credentials. Generate both with npm run journal:setup.
JOURNAL_PASSWORD_HASH=
JOURNAL_SESSION_SECRET=

# Required on Vercel. Use the standard read/write REST token, not the read-only token.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional local development path only. Local entries are not uploaded to production.
# JOURNAL_DATA_FILE=.journal/entries.json
